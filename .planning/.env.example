# ============================================================
# SADDLEWOOD ESTIMATE PORTAL — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — safe to expose (used in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://rwzmcknxlucwbhsyxdcx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRET, server-side only, bypasses Row Level Security
# Get from: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Auth — email address that is allowed to access /internal routes
INTERNAL_ALLOWED_EMAIL=marco@saddlewoodcontracting.com

# Pipeline ingest secret — Bearer token the AI pipeline sends when pushing estimates
# Generate with: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PIPELINE_INGEST_SECRET=

# Cron job secret — Vercel sends this header when triggering /api/cron/follow-ups
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Email delivery — Resend API
# Get from: resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_ADDRESS=info@saddlewoodcontracting.com
MARCO_EMAIL=marco@saddlewoodcontracting.com

# App URL — used for building share links and email CTAs
NEXT_PUBLIC_APP_URL=https://saddlewoodcontracting.com

# Phase 9 only (optional — Dropbox Sign e-signature)
# DROPBOX_SIGN_API_KEY=
